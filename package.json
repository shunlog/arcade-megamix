{
  "name": "arcade-megamix-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "description": "TypeScript + HTML5 canvas port of Arcade Megamix.",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "serve": "node serve.mjs",
    "dev": "tsc --watch --preserveWatchOutput & live-server --port=8080 --watch=dist,index.html,embed.html --open=/",
    "start": "pnpm run build && node serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test test"
  },
  "devDependencies": {
    "live-server": "^1.2.2",
    "typescript": "^5.5.0"
  }
}
